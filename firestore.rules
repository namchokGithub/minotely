rules_version = '2';

// Any Google account may sign in; each user reads and writes only their own
// users/{uid} data (D22), with shape checks (D17).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isUser(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    function validBook(d) {
      return d.keys().hasOnly(["name", "color", "icon", "order", "createdAt", "updatedAt"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        // Preset key or custom #rrggbb (M5.3).
        && d.color is string
        && (d.color in ["gray", "red", "orange", "amber", "green", "teal", "blue", "indigo", "purple", "pink"]
          || d.color.matches("^#[0-9a-fA-F]{6}$"))
        && d.icon is string && d.icon.size() <= 40
        && d.order is number
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validNote(d) {
      return d.keys().hasOnly([
          "bookId", "title", "content", "plainText", "tags", "isPinned", "isLocked",
          "paperStyle", "order", "createdAt", "updatedAt", "deletedAt"
        ])
        && d.bookId is string && d.bookId.size() > 0
        && d.title is string && d.title.size() <= 200
        && d.content is string
        && d.plainText is string
        && d.tags is list && d.tags.size() <= 20
        && d.isPinned is bool
        // Notes created before M5.6 have no `isLocked`.
        && d.get("isLocked", false) is bool
        && d.paperStyle in ["plain", "lined", "grid", "dotted"]
        // Notes created before custom sort have no `order`.
        && d.get("order", 0) is number
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && (d.deletedAt == null || d.deletedAt is timestamp);
    }

    function validSettings(d) {
      return d.keys().hasOnly(["fontFamily", "fontSize"])
        && d.get("fontFamily", "sans") in ["sans", "serif", "mono"]
        && d.get("fontSize", "md") in ["sm", "md", "lg"];
    }

    match /users/{uid}/books/{bookId} {
      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) && validBook(request.resource.data);
      allow update: if isUser(uid) && validBook(request.resource.data) && keepsCreatedAt();
    }

    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) && validNote(request.resource.data);
      allow update: if isUser(uid) && validNote(request.resource.data) && keepsCreatedAt();
    }

    match /users/{uid}/preferences/{docId} {
      allow read: if isUser(uid) && docId == "settings";
      allow write: if isUser(uid) && docId == "settings"
        && validSettings(request.resource.data);
    }
  }
}
